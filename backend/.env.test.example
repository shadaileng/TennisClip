# 测试环境配置模板（入库）。复制为 .env.test 后填写，.env.test 不入库。
# 用途：测试与开发/生产配置彻底隔离，测试数据统一落入 data_test/，绝不触碰真实 data/。
#
# 启用方式（任选其一）：
#   1. 测试启动时由 backend/tests/conftest.py 自动设置 TENNISCLIP_ENV=test，
#      使所有 load_config() 自动加载本文件（.env.test）。
#   2. 手动设置环境变量后运行：TENNISCLIP_ENV=test uv run pytest
#
# 优先级：进程环境变量 > .env.test（本文件）> config.yaml > 代码默认值
# 说明：load_dotenv(override=False)，CI/K8s 注入的变量始终优先，安全边界不退化。

# ===== 默认提供商：StepFun（占位 Key，测试不调用真实接口） =====
STEPFLASH_API_KEY=sk-test-xxxx
# config.yaml: llm.active_provider = default

# ===== 测试数据库（落在 data_test/ 下，与开发库隔离） =====
# 优先级：进程环境变量 > .env.test > config.yaml > 代码默认（SQLite）
# alembic 迁移在 TENNISCLIP_ENV=test 下自然指向本库，与运行时同源。
DATABASE_URL=sqlite:///./data_test/tennisclip_test.db

# ===== 测试数据目录（输入/输出/日志/数据库统一归入） =====
# 优先级：进程环境变量 > .env.test > config.yaml > 代码默认（data）
# 未设置时由 tests/conftest.py 初始化兜底落到 data_test，确保不触碰真实 data/。
TENNISCLIP_DATA_DIR=data_test

# ===== 日志级别（可选） =====
# 保持默认 INFO，避免干扰 test_logging.py 的级别断言；排查测试日志时临时开启：
# TENNISCLIP_LOG_LEVEL=DEBUG

# ===== 跨域配置（测试通常无需调整，沿用默认 *） =====
# CORS_ALLOWED_ORIGINS=*

# ===== 按环境区分（dev/test/prod 各放一份 .env） =====
# 差异主要靠此文件收敛：DATABASE_URL + 各 *_API_KEY + active_provider
