# 后端（backend/）
backend/.venv/
backend/.uv-cache/
# 统一数据目录：数据库/输入/输出/日志（整体忽略）
backend/data/
# 测试数据目录（隔离于 data/，不入库）
backend/data_test/
# 测试库（根目录遗留，单独忽略）
backend/test_roundtrip.db
# CV 权重文件（ultralytics 自动下载可能落 cwd；正式权重在 backend/data/models/ 已随 data/ 忽略）
backend/*.pt
# 测试环境配置（本地用，由 .env.test.example 复制，不入库）
backend/.env.test

# 前端（frontend/）
frontend/node_modules/
frontend/dist/
frontend/.pnpm-store/

# pnpm 虚拟 store（在仓库根目录，随 pnpm 配置变动）
/.pnpm-store/

# 通用
__pycache__/
*.pyc
.env
.pytest_cache/
pytest-cache-files-*/
.DS_Store

# pnpm 全局 store（在仓库根目录生成）
/.pnpm-store/
# 根目录依赖（VitePress 等）
/node_modules/

# 文档站构建产物（VitePress）
docs/.vitepress/dist/
docs/.vitepress/cache/

# docs-manage skill：参考代码目录不纳入版本管理
docs/reference/

# codebuddy 自动生成的规划文件（工作区临时产物，不入库）
.codebuddy/plans/
